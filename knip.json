{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"ignoreIssues": {
		"tsconfig.json": ["unlisted"]
	},
	"entry": [
		"src/env.ts",
		"tests/**/*.{js,ts}",
		".storybook/**/*.{js,ts}",
		"scripts/**/*.{js,mjs,cjs,ts}",
		"contentful/migrations/**/*.{js,cjs}"
	],
	"project": [
		"src/**/*",
		"tests/**/*.{js,ts}",
		".storybook/**/*.{js,ts}",
		"scripts/**/*.{js,mjs,cjs,ts}",
		"contentful/migrations/**/*.{js,cjs}",
		"*.config.{js,ts}"
	]
}
