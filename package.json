{
	"name": "cipowell-svelte",
	"version": "0.0.1",
	"private": true,
	"engines": {
		"node": "24.14.1"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "npm run check:types && npm run check:deps",
		"check:types": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:deps": "knip",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "npm run lint:format && npm run lint:code && npm run lint:docs",
		"lint:format": "prettier --check .",
		"lint:code": "eslint .",
		"lint:docs": "markdownlint-cli2 \"**/*.md\"",
		"format": "prettier --write .",
		"test": "npm run test:unit && npm run test:storybook && npm run test:integration",
		"test:integration": "playwright test",
		"test:unit": "vitest",
		"test:storybook": "vitest --project=storybook",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"security": "npm run security:deps && npm run security:secrets && npm run security:sast",
		"security:deps": "node ./scripts/quality/security-deps.mjs",
		"security:secrets": "node ./scripts/quality/security-secrets.mjs",
		"security:sast": "node ./scripts/quality/security-sast.mjs",
		"ci": "npm run lint && npm run check && npm run build && npm run build-storybook && npm run test && npm run security",
		"contentful:migration:new": "node scripts/contentful/new-migration.mjs",
		"contentful:migration:run": "node scripts/contentful/run-migration.mjs",
		"contentful:migration:verify": "node scripts/contentful/lint-and-test.mjs",
		"contentful:migration:rollback": "node scripts/contentful/run-migration.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.59.1",
		"@storybook/addon-a11y": "^10.6.7",
		"@storybook/addon-docs": "^10.6.7",
		"@storybook/addon-links": "^10.6.7",
		"@storybook/addon-svelte-csf": "^5.1.6",
		"@storybook/addon-vitest": "^10.6.7",
		"@storybook/svelte": "^10.6.7",
		"@storybook/sveltekit": "^10.6.7",
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@testing-library/svelte": "^5.3.1",
		"@types/node": "^26.6.2",
		"@vitest/browser-playwright": "^5.1.0",
		"@vitest/coverage-v8": "^5.1.0",
		"@vitest/ui": "^5.1.0",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-storybook": "^10.6.7",
		"eslint-plugin-svelte": "^3.17.1",
		"globals": "^17.6.0",
		"jsdom": "^29.1.1",
		"knip": "^6.37.0",
		"markdownlint-cli2": "^0.24.1",
		"playwright": "^1.59.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^3.5.1",
		"remark-gfm": "^4.0.1",
		"storybook": "^10.6.7",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	},
	"overrides": {
		"@sveltejs/kit": {
			"cookie": "^2.0.1"
		},
		"axios": "1.21.1",
		"contentful-sdk-core": {
			"lodash": "4.18.1"
		},
		"katex": "0.19.1",
		"markdownlint-cli2": {
			"smol-toml": "1.9.1"
		},
		"miniflare": {
			"undici": "7.30.2"
		},
		"minimatch": "^11.0.8",
		"postcss-load-config": {
			"yaml": "1.10.3"
		}
	},
	"type": "module",
	"dependencies": {
		"@contentful/live-preview": "^4.10.2",
		"@lucide/svelte": "^1.14.0",
		"contentful": "^11.12.10"
	}
}
